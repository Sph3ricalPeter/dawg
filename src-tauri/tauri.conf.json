{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dawg",
  "mainBinaryName": "dawg",
  "version": "0.0.1",
  "identifier": "com.sph3ricalpeter.dawg",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dawg",
        "width": 1440,
        "height": 860,
        "minWidth": 960,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/Sph3ricalPeter/dawg/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Sph3ricalPeter",
    "category": "Music",
    "shortDescription": "A simple DAW for sound design",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
